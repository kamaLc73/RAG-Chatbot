schema video {
  document video {
    field video_id type string {
      indexing: summary | attribute
    }
    field title type string {
      indexing: index | summary
      index { enable-bm25 }
    }
    field transcript type string {
      indexing: index | summary
      index { enable-bm25 }
    }
    field org type string {
      indexing: summary | attribute
      rank: filter
    }
    field url type string {
      indexing: summary | attribute
    }
    field thumbnail_url type string {
      indexing: summary | attribute
    }
    field upload_date type string {
      indexing: summary | attribute
    }
    field embedding type tensor<float>(x[1024]) {
      indexing: attribute | index
      attribute { distance-metric: angular }
      index {
        hnsw {
          max-links-per-node: 16
          neighbors-to-explore-at-insert: 200
        }
      }
    }
  }

  rank-profile hybrid inherits default {
    inputs {
      query(q_embedding) tensor<float>(x[1024])
    }
    first-phase {
      expression: 0.5 * closeness(field, embedding) + 0.5 * bm25(title)
    }
    second-phase {
      rerank-count: 20
      expression: 0.4 * closeness(field, embedding) + 0.3 * bm25(title) + 0.3 * bm25(transcript)
    }
    match-features: closeness(field, embedding) bm25(title)
  }
}
