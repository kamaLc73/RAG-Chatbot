schema doc {
  document doc {
    field doc_id type string {
      indexing: summary | attribute
    }
    field text type string {
      indexing: index | summary
      index { enable-bm25 }
    }
    field org type string {
      indexing: summary | attribute
      rank: filter
    }
    field source_type type string {
      indexing: summary | attribute
    }
    field faq_scope type string {
      indexing: summary | attribute
    }
    field relative_source type string {
      indexing: summary | attribute
    }
    field chunk_index type int {
      indexing: summary | attribute
    }
    field embedding type tensor<float>(x[1024]) {
      indexing: attribute | index
      attribute { distance-metric: angular }
      index {
        hnsw {
          max-links-per-node: 16
          neighbors-to-explore-at-insert: 200
        }
      }
    }
  }

  rank-profile hybrid inherits default {
    inputs {
      query(q_embedding) tensor<float>(x[1024])
    }
    first-phase {
      expression: if(attribute(source_type) == "faq", 1.3, 1.0) * (0.6 * closeness(field, embedding) + 0.4 * bm25(text))
    }
    second-phase {
      rerank-count: 50
      expression: if(attribute(source_type) == "faq", 1.3, 1.0) * (0.5 * closeness(field, embedding) + 0.5 * bm25(text))
    }
    match-features: closeness(field, embedding) bm25(text)
  }
}
