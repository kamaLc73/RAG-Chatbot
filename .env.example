# Local environment template for the RCAR/CNRA RAG chatbot.
# Copy this file to .env and adapt values for your machine.
# Do not commit .env because it may contain API keys.

# -----------------------------------------------------------------------------
# Frontend / API
# -----------------------------------------------------------------------------
DOCKER_VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
API_DEBUG=false

# Local admin bootstrap. Leave empty to skip automatic user creation.
API_BOOTSTRAP_SUPERUSER_EMAIL=
API_BOOTSTRAP_SUPERUSER_USERNAME=
API_BOOTSTRAP_SUPERUSER_FULL_NAME=Admin local
API_BOOTSTRAP_SUPERUSER_PASSWORD=

# Security
JWT_SECRET_KEY=change-me-local-dev
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Startup behavior
API_LOAD_RAG_ON_STARTUP=true
API_LOAD_AUDIO_ON_STARTUP=true
API_AUDIO_MODEL_SIZE=small
API_AUDIO_LANGUAGE=fr
API_CLEAR_ADMIN_CACHE_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Persistence and cache
# -----------------------------------------------------------------------------
# Used when running the API outside Docker from the host machine.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_pass@localhost:5433/chatbot_db

CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6380/0
CACHE_KEY_PREFIX=rag-chatbot:
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_CONNECT_TIMEOUT_SECONDS=0.25
REDIS_RETRY_AFTER_SECONDS=5.0

# -----------------------------------------------------------------------------
# Vespa
# -----------------------------------------------------------------------------
# Host-machine access. Docker Compose injects VESPA_URL=http://vespa for containers.
VESPA_URL=http://localhost
VESPA_PORT=8080
VESPA_CONTENT_CLUSTER=rcar_cnra

# -----------------------------------------------------------------------------
# LLM, embeddings and reranking
# -----------------------------------------------------------------------------
OLLAMA_MODEL=ministral-3:14b-cloud
OLLAMA_BASE_URL=http://localhost:11434
DOCKER_OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST_PORT=11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_API_KEY=

EMBEDDING_MODEL=BAAI/bge-m3
HF_TOKEN=

# -----------------------------------------------------------------------------
# Optional OCR / evaluation providers
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=

CEREBRAS_API_KEY=
RAGAS_CEREBRAS_MODEL=gpt-oss-120b
RAGAS_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
RAGAS_CEREBRAS_REQUESTS_PER_MINUTE=2
RAGAS_CEREBRAS_MAX_COMPLETION_TOKENS=1536
RAGAS_CEREBRAS_API_KEY_ENV=CEREBRAS_API_KEY
RAGAS_CEREBRAS_REASONING_EFFORT=low
RAGAS_CEREBRAS_REASONING_FORMAT=hidden
